# WikiHop — Backend environment variables
# Copier ce fichier en .env et adapter les valeurs
# Ne jamais committer le fichier .env (déjà dans .gitignore)

# Serveur
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Base de données PostgreSQL (F-06)
# Démarrer avec : npm run db:up (depuis la racine)
DATABASE_URL=postgresql://wikihop:wikihop_local@localhost:5432/wikihop_dev

# Wikipedia
WIKIPEDIA_LANG=fr

# Cache
CACHE_TTL_SECONDS=3600

# Sécurité (P-03)
# CORS : origines autorisées en production (séparées par des virgules)
# Non requis en développement (origin: true par défaut)
# Note : les apps React Native natives n'envoient pas d'en-tête Origin
# CORS_ORIGIN=https://api.wikihop.app

# Rate limiting : max requêtes par IP par fenêtre de 60s (défaut : 60)
RATE_LIMIT_MAX=60

# Token secret pour les routes d'administration (Bearer token)
# OBLIGATOIRE en production — si absent, la route admin répond 401 (fail-safe)
# ADMIN_SECRET_TOKEN=changeme-in-production

# Test (utilisé par la CI — override DATABASE_URL)
# DATABASE_URL=postgresql://wikihop:wikihop@localhost:5432/wikihop_test
